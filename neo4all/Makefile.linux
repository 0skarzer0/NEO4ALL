O      = o
RM     = rm -f
CC     = gcc
CXX    = g++
STRIP  = strip

CDROM_OBJ=src/cdrom/linux.o
FAME_OBJ=src/68k/fame/fame.o
FAME_SRC=src/68k/fame/fame.asm
ASM_TYPE=elf

include config.mk

PROG   = $(NAME)

all: $(PROG)

DEFAULT_CFLAGS = `sdl-config --cflags` -D_REENTRANT -DINLINE="static inline" -DLOWERCASEFILES -DDATA_PREFIX=\"data/\" -DROM_PREFIX=\"data/\" -DMEMCARD_PREFIX=\"/tmp/\"
LDFLAGS        = `sdl-config --libs`

ifdef VIDEOGL
LDFLAGS+= -lGL
endif

ifdef MENU_MUSIC
LDFLAGS+= -lSDL_mixer
endif


MORE_CFLAGS = -O3 -fomit-frame-pointer -fstrict-aliasing -Isrc -Isrc/68k -Isrc/video

CFLAGS  = $(DEFAULT_CFLAGS) $(NEO4ALL_CFLAGS) $(MORE_CFLAGS)


$(PROG): $(OBJS) $(Z80_OBJS) $(MEMORY_OBJ) $(OBJS_68K)
	$(CC) $(CFLAGS) -o $(PROG) $(OBJS) $(OBJS_68K) $(MEMORY_OBJ) $(Z80_OBJS) $(LDFLAGS)
	$(STRIP) $(PROG)


run: $(PROG)
	./$(PROG)

clean:
	$(RM) $(PROG) $(OBJS) src/68k/c68k/cpu68k.o src/z80/z80intrf.o $(MEMORY_OBJ)


clean-cores:
	$(RM) $(Z80_OBJS) $(OBJS_68K)
